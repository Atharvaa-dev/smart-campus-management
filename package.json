{
  "name": "smart-campus",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Campus student portal with an Express and MySQL API",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "test": "node --test",
    "admin:create": "node server/src/cli/create-account.js --role admin",
    "student:create": "node server/src/cli/create-account.js --role student"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.1",
    "zod": "^3.25.28"
  }
}
