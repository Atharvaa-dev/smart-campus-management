NODE_ENV=development
PORT=3000
# Comma-separated frontend origins if you use a separate frontend server.
# Add the exact Live Server origin(s); localhost is recommended for cookie auth.
CORS_ORIGINS=http://localhost:5500

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=smart_campus
MYSQL_USER=smart_campus_app
MYSQL_PASSWORD=replace_with_your_mysql_password

# Generate locally, for example: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters_long
BCRYPT_ROUNDS=12
TRUST_PROXY_HOPS=0
